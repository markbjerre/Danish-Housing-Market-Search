# Copenhagen apartment monitor. Copy to .env in the repo root and fill in.
# No Anthropic key is needed: verdicts run through the claude CLI against the
# existing subscription.

# Telegram. Create the bot with @BotFather, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging it once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides. Defaults shown.
# KBH_DB_PATH=kbh/data/kbh.sqlite3
# KBH_ALERT_THRESHOLD=72
# KBH_AI_ENABLED=1
# KBH_AI_MIN_SCORE=62
# KBH_AI_MODEL=claude-haiku-4-5-20251001
# KBH_AI_SYNTHESIS_MODEL=claude-opus-5
# KBH_AI_WORKERS=3
# KBH_AI_BATCH_SIZE=6
# KBH_AI_USE_PHOTOS=0
# KBH_AI_MAX_IMAGES=5
# KBH_CLAUDE_BIN=
# KBH_WEB_PORT=5001
